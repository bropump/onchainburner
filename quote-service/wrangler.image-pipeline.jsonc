{
  "$schema": "../app/node_modules/wrangler/config-schema.json",
  "name": "onchain-burner-image-pipeline",
  "main": "cloudflare-image-worker.mjs",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat"],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
